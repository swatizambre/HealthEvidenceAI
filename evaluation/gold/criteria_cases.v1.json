      "id": "a1c-above-percent",
      "path": "rules",
      "tags": ["lab", "positive"],
      "notes": [],
      "labs": [
        {
          "test_name": "HbA1c",
          "content": "HbA1c: 8.1 %",
          "value": "8.1",
          "unit": "%"
        }
      ],
      "criterion": {
        "code": "CRIT-A1C",
        "description": "HbA1c > 7%.",
        "rule": {
          "type": "lab_test",
          "test_name": "HbA1c",
          "comparator": ">",
          "threshold": 7.0,
          "unit": "%",
          "missing_label": "HbA1c > 7%"
        }
      },
      "expected_status": "SUPPORTED",
      "min_citations": 1
