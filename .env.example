# Application environment

ENVIRONMENT=local
LOG_LEVEL=INFO
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite for local development; use PostgreSQL in Docker and production.
DATABASE_URL=sqlite:///./data/healthevidence.db
# DATABASE_URL=postgresql+psycopg://healthevidence:healthevidence@127.0.0.1:5432/healthevidence

# LLM routing: set LLM_PROVIDER to choose the chat backend.
#   gemini  -> Google GenAI generateContent (GEMINI_MODEL_NAME + GEMINI_API_KEY)
#   ollama  -> local Ollama /api/chat (OLLAMA_MODEL_NAME + OLLAMA_BASE_URL)
#   openai / anthropic / local as documented in README
LLM_PROVIDER=ollama
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
OLLAMA_MODEL_NAME=medgemma:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional legacy override (prefer provider-specific names above):
# MODEL_NAME=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Never commit real keys — use a secret manager for shared pilot / production.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

EMBEDDING_MODEL=dense-hash-v1
# dense-hash (local) | openai (requires OPENAI_API_KEY)
EMBEDDING_BACKEND=dense-hash
EMBEDDING_DIM=256
ENABLE_TRACING=true
LLM_TIMEOUT_SECONDS=120
LLM_FALLBACK_PROVIDERS=local
# ai_primary = LLM clinical intelligence scores criteria first; rules = deterministic only
CRITERIA_EVAL_MODE=ai_primary
# Gap visit-note coaching drafts (unset = follow criteria mode). See docs/AI_SCOPE.md
# AI_GAP_DRAFTS=true
A2A_ENABLED=true
IMAGING_BACKEND=monai

# Auth: dev-jwt for local only; pilot/staging/production require oidc (dev-token minting off).
# Pilot template: .env.pilot.example — see docs/PILOT_ROADMAP.md
AUTH_MODE=dev-jwt
# Required for AUTH_MODE=dev-jwt (no hard-coded default). Copy into local .env.
# Must be ≥32 characters. Never commit real secrets; .env is gitignored.
DEV_JWT_SECRET=change-me-local-only-healthevidence
OIDC_AUDIENCE=healthevidence-api
OIDC_REQUIRED_ROLES=patient,senior_clinician,resident,staff,admin,reviewer
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLES_CLAIM=roles

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,es,fr,de,pt,hi,ar,zh,ja
DATA_RESIDENCY_REGION=global

# PHI: leave false for synthetic/consent demo. Production ALLOW_PHI requires attestation.
ALLOW_PHI=false
PHI_PROGRAM_ATTESTED=false
# Cloud LLM + PHI requires BAA + explicit egress attestation (or use local/ollama).
LLM_BAA_ATTESTED=false
LLM_PHI_EGRESS_ALLOWED=false
# Invented lifelong biography: unset = local/test only; never when ALLOW_PHI=true.
# SYNTHETIC_LIFELONG=false
DEFAULT_ORG_CODE=ORG-000001
DEFAULT_ORG_NAME=Demo Health System
# Pilot/staging multi-facility: require org_id/org_code on care-team tokens (admin bypasses).
# Unset = auto-on for pilot/staging/production/kubernetes; false keeps full local catalog
ENFORCE_ORG_SCOPE=false
# Unset = on for staging/production/kubernetes; assigned cases restricted to assignee/senior/admin
# ENFORCE_NEED_TO_KNOW=false
# Hospital simulator (Visit note "Simulate hospital visit"). Unset = local/test/pilot only.
# HOSPITAL_ALLOW_SIMULATE=false
# HIS/FHIR machine auth (header X-Hospital-Api-Key). Empty = JWT/OIDC only.
# HOSPITAL_INTERFACE_API_KEY=
# Open evidence-pack SLA (minutes) for Today breach flags / ops metrics.
PACKET_SLA_MINUTES=240
# Shared live (staging/production/kubernetes): SEED_ON_STARTUP must be false.
# SEED_ON_STARTUP=false
# Optional durable span export
# OTEL_EXPORTER_OTLP_ENDPOINT=
# HE_TRACE_LOG=false

# Multi-replica desk push: uv sync --extra realtime && set REDIS_URL
REDIS_URL=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
