# Pilot stack (PostgreSQL required). Copy to .env.pilot and merge into .env for local pilot runs.
# Order: production/pilot hardening first, sales demo polish last — see docs/PILOT_ROADMAP.md.

ENVIRONMENT=pilot
LOG_LEVEL=INFO
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+psycopg://healthevidence:healthevidence@127.0.0.1:5432/healthevidence

LLM_PROVIDER=local
LLM_FALLBACK_PROVIDERS=local
CRITERIA_EVAL_MODE=ai_primary
IMAGING_BACKEND=monai
A2A_ENABLED=true

# Pilot requires OIDC — /auth/dev-token is disabled (see Settings.dev_token_allowed).
AUTH_MODE=oidc
OIDC_AUDIENCE=healthevidence-api
OIDC_REQUIRED_ROLES=patient,senior_clinician,resident,staff,admin,reviewer
OIDC_CLIENT_ID=healthevidence-api
OIDC_ROLES_CLAIM=roles
# Local Keycloak (docker-compose.oidc.yml):
OIDC_ISSUER=http://127.0.0.1:8080/realms/healthevidence
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/healthevidence/protocol/openid-connect/certs
# Or: uv run python -m app.cli.oidc_discover http://127.0.0.1:8080/realms/healthevidence

ALLOW_PHI=false
PHI_PROGRAM_ATTESTED=false
DEFAULT_ORG_CODE=ORG-000001
DEFAULT_ORG_NAME=Demo Health System
# Set true when IdP mints org_id/org_code (or facility_code) on care-team tokens.
ENFORCE_ORG_SCOPE=false
